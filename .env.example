# Copy to .env in the repository root. Never commit .env.
# Local tools load this file; shell environment variables take precedence.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium

# Desktop: only demo is supported. Paths are relative to the repository.
APP_MODE=demo
APP_PORT=8000
DEMO_FIXTURE=demo/species.json
